# Copy this file to .env.local and fill in values from your Supabase
# project's Settings → API Keys page.
#
# Never put real values in THIS file — it's committed to git as a
# template. Real values belong only in .env.local, which .gitignore
# excludes.
#
# Use the "Publishable and secret API keys" tab, not "Legacy" — legacy
# anon/service_role JWT keys are disabled on this project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Secret key — server-only, never expose to the browser. Used only to
# let admins create staff logins from the Admin panel.
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Outbound email — separate from Supabase Auth's own SMTP settings (which
# only cover Supabase's own password-reset/invite emails). Used for the
# app's own notifications: cash sheet upload confirmations and the
# monthly missing-cash-sheets digest. Reuses whatever Gmail account +
# App Password you already set up for Supabase Auth's SMTP, or any other
# SMTP provider — this is just standard SMTP credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM=you@gmail.com

# Shared secret Vercel Cron sends as a Bearer token when it calls
# /api/cron/missing-cash-sheets — generate any random string (e.g.
# `openssl rand -hex 32`) and set the same value in Vercel's project
# settings.
CRON_SECRET=a-long-random-string
