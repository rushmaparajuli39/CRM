# Copy this file to .env.local and fill in values from your Supabase
# project's Settings → API page.
#
# Never put real values in THIS file — it's committed to git as a
# template. Real values belong only in .env.local, which .gitignore
# excludes.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, never expose to the browser. Used only
# to let admins create staff logins from the Admin panel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
