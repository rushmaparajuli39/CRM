# Copy this file to .env.local and fill in values from your Supabase
# project's Settings → API Keys page.
#
# Never put real values in THIS file — it's committed to git as a
# template. Real values belong only in .env.local, which .gitignore
# excludes.
#
# Use the "Publishable and secret API keys" tab, not "Legacy" — legacy
# anon/service_role JWT keys are disabled on this project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Secret key — server-only, never expose to the browser. Used only to
# let admins create staff logins from the Admin panel.
SUPABASE_SECRET_KEY=sb_secret_your-key-here
